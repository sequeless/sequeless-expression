<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.sequeless</groupId>
    <artifactId>sequeless-build-parent</artifactId>
    <version>0.1.3</version>
    <relativePath/>
  </parent>

  <groupId>org.sequeless</groupId>
  <artifactId>expression-jexl-adapter</artifactId>
  <version>0.1.3</version>
  <name>expression-jexl-adapter</name>
  <description>The default ExpressionPort adapter: Commons JEXL 3 in a sandboxed, side-effect-free configuration (no reflection, no static method/class access).</description>

  <properties>
    <sequeless.enforcer.core.skip>false</sequeless.enforcer.core.skip>
    <sequeless.github.repository>sequeless-expression</sequeless.github.repository>
    <jexl.version>3.6.2</jexl.version>
    <assertj.version>3.27.7</assertj.version>
    <junit.version>6.1.3</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>expression-api</artifactId>
      <version>0.1.2</version>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-values</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-jexl3</artifactId>
      <version>${jexl.version}</version>
    </dependency>

    <!-- The contract test extends ExpressionContract from the testkit. -->
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>expression-testkit</artifactId>
      <version>0.1.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5-api</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/*</url>
    </repository>
  </repositories>
</project>
